# Telegram API 凭证 (从 my.telegram.org 获取)
API_ID=
API_HASH=

# 你想转存到的目标频道或群组 ID（留空 = 仅下载模式）
TARGET_CHAT=-100xxxx

# ===== 磁力链接下载（可选，均有默认值） =====
# 并发上传上限（默认 4；过高易触发 Telegram FloodWait 限流，建议 3-5）
MAX_UPLOAD_CONCURRENCY=4
# 单文件大小上限(GB)，超过则不下载、不上传（默认 4，对应 Premium 4GB）
MAX_FILE_SIZE_GB=4
# 下载目录（默认 ./downloads）
DOWNLOAD_DIR=./downloads
# 种子长时间无下载速度即放弃的秒数（默认 300，用于处理“无人做种”）
TORRENT_STALL_TIMEOUT=300
