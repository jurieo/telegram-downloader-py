# Telegram API 凭证 (从 my.telegram.org 获取)
API_ID=
API_HASH=

# 备份集合：可填多个频道/群组 ID，用英文逗号分隔，构成「互为备份」集合。
# 规则：收藏夹(me)里的视频/链接 → 转发到集合全部；集合中某个里出现的视频 → 转发到集合其余成员。
# 全部为「无引用转发」（不带「转发自」标签）。留空 = 仅下载模式。
TARGET_CHAT=-1001111111111,-1002222222222,-1003333333333

# 单向监听源（可选）：逗号分隔的机器人/频道/群 ID。
# 源里出现的图片/视频 → 无引用转发到 TARGET_CHAT 全部成员；源永不作为转发目标（不回流）。
# 典型用法：把「下载机器人」的对话加进来，它回给你的视频自动镜像到备份组。
# 机器人对话的 ID 是正数（用户 ID），频道/群是 -100 开头；可用 scripts/list_dialogs.py 查询。
SOURCE_CHAT=

# ===== 磁力链接下载（可选，均有默认值） =====
# 并发上传上限（默认 4；过高易触发 Telegram FloodWait 限流，建议 3-5）
MAX_UPLOAD_CONCURRENCY=4
# 相册/多文件从源下载时的并发上限（默认 4；设 1 退回逐个下载）
MAX_DOWNLOAD_CONCURRENCY=4
# 单文件大小上限(GB)，超过则不下载、不上传（默认 4，对应 Premium 4GB）
MAX_FILE_SIZE_GB=4
# 下载目录（默认 ./downloads）
DOWNLOAD_DIR=./downloads
# 种子长时间无下载速度即放弃的秒数（默认 300，用于处理“无人做种”）
TORRENT_STALL_TIMEOUT=300

# ===== 转发限速（可选） =====
# 每两次转发之间的最小间隔秒数（默认 3，防止瞬时突发触发 Telegram FloodWait 限流；设 0 关闭）
FORWARD_INTERVAL=3

# ===== 本地文件清理（可选） =====
# 转发/上传成功后是否删除本地下载的文件（默认 true 删除；设 false 保留在 DOWNLOAD_DIR）
DELETE_AFTER_UPLOAD=true
